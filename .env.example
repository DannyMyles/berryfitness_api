# Berry Fitness for Health API. Copy to .env; never commit real values.

# MariaDB database for Berry only.
DATABASE_URL="mysql://berry_fitness:change-me@localhost:3306/berry_fitness"
PORT=4001
# In production, set HOST=127.0.0.1 so only the local reverse proxy can reach the API.
# HOST=127.0.0.1

# Long random value: openssl rand -base64 48
JWT_SECRET="change-me"
JWT_EXPIRES_IN="24h"

# The website URL (used in CORS and in email links).
CORS_ORIGINS="http://localhost:3002"
FRONTEND_URL="http://localhost:3002"

# Email. Without it, emails are logged as "skipped"; records are still saved.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="info@berryfitnessforhealth.com"
# SMTP_PASS="an-app-password"
# MAIL_FROM="info@berryfitnessforhealth.com"
# Where new order and booking alerts go (defaults to SMTP_USER).
# ADMIN_NOTIFICATION_EMAIL="info@berryfitnessforhealth.com"
# Dev only: save rendered emails as .html/.txt when SMTP isn't configured.
MAIL_PREVIEW_DIR="./.mail-preview"

# Optional: loads the gallery's YouTube videos.
# YOUTUBE_API_KEY=""

# Read by npm run seed.
# BERRY_FRONTEND_URL="http://localhost:3002"
# BERRY_ADMIN_EMAIL="admin@berryfitnessforhealth.com"
# BERRY_ADMIN_PASSWORD="choose-a-strong-password"
# BERRY_DIR="../berry"
